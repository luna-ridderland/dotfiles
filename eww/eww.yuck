;; Bar Widgets ;;
(defwindow bar
    :monitor 1
    :geometry (geometry
        :x "0px"
        :y "0px"
        :width "100%"
        :height "2%"
        :anchor "top center"
    )
    
    :exclusive true
    :namespace "eww-topbar"
    :stacking "bottom"
    (xbar)
)

(defwidget xbar []
    (centerbox
        :orientation "h"
        (box
            :class "segment-left"
            :halign "start"
            (left)
        )
        (box
            :halign "center"
            :class "middle"
            (center)
        )
        (box
            :halign "end"
            :class "segment-right"
            (right)
        )
    )
)
      
(deflisten workspace "scripts/workspaces")
(defwidget workspaces []
(literal :content workspace))

(defwidget left []
    (workspaces)
)
(defwidget center []
    "${hour}:${min}"
    
    
)
(defwidget right []
    "right"
)

(defpoll hour :interval "1s" "date +%H")
(defpoll min  :interval "1s" "date +%M")
(defpoll sec  :interval "1s" "date +%S")

(defpoll day_word :interval "10m" "date +%a | tr [:upper:] [:lower:]")
(defpoll day      :interval "10m" "date +%d")
(defpoll month    :interval "1h"  "date +%m")
(defpoll year     :interval "1h"  "date +%y")

(deflisten workspaces :interval "1s" :initial `hyprctl -j workspaces | jq -r 'map(.id)'` `hyprctl -j workspaces | jq -r 'map(.id)'`)
